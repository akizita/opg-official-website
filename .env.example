# Public application URL. Use http://localhost:3000 locally. Auth confirmation,
# Google sign-in, and password reset redirect back to this origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep drafts and preview deployments out of search engines. Set to true only
# for an approved production release after content, legal, and SEO checks.
SITE_INDEXABLE=false

# Supabase publishable values. Obtain these from the dedicated OPG website
# project after the OPGlobal account is connected. Never add secret/service keys
# to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional local override. MFA is bypassed by default only under `next dev`.
# Set to true to test the production AAL2 flow during local development.
ADMIN_MFA_REQUIRED=false

# Server-only integrations. Set SUPABASE_SECRET_KEY to save public contact
# inquiries into the protected admin inbox; never expose it as NEXT_PUBLIC_*.
# For Turnstile verification, configure both Turnstile keys together.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Consent-gated analytics; keep blank until the implementation and notices are approved.
NEXT_PUBLIC_GTM_ID=

# Google Maps Platform (Maps JavaScript API & Advanced Markers)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
